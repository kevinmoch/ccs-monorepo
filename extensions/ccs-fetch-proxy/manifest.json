{
  "manifest_version": 3,
  "name": "CCS Fetch Proxy",
  "version": "0.1.0",
  "description": "Proxy fetch requests and AI page perception/actions through the CCS shell's embedded cross-origin iframes (with the sub-site's login session), and keep sub-site navigation inside the shell instead of opening new windows.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_start",
      "js": ["content/isolated.js"]
    },
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_start",
      "js": ["content/main-world.js", "content/dom-agent.js"],
      "world": "MAIN"
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  }
}
