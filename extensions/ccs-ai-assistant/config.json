{
  "manifest": {
    "name": "CCS AI 助手",
    "version": "0.24.0",
    "description": "CCS 基建云平台 AI 助手",
    "update_url": "http://localhost:3333/release/updates.xml"
  },
  "agentRuntime": {
    "agentCapabilities": {
      "skillGeneration": true,
      "generativeUi": true,
      "delegation": true
    },
    "multimodal": {
      "imageAttachments": true,
      "pageImageCapture": true
    }
  },
  "sandbox": {
    "downloadedFiles": true,
    "uploadFiles": true,
    "allowHttp": true,
    "allowPrivateHosts": true,
    "capabilities": {
      "fetchData": true
    },
    "documentSurface": true
  },
  "quickPrompts": {
    "limit": 8,
    "items": [
      {
        "id": "qp-summarize",
        "text": {
          "zh": "总结当前页面",
          "en": "Summarize this page"
        },
        "icon": "page"
      },
      {
        "id": "qp-skills",
        "text": {
          "zh": "有哪些可用技能？",
          "en": "What skills are available?"
        },
        "icon": "list"
      }
    ]
  },
  "privacy": {
    "userProfile": true
  },
  "siteAccess": {
    "allowedHosts": []
  },
  "console": {
    "usageCost": {
      "enabled": true,
      "cnyPerMillionTokens": 9,
      "cnyPerUsd": 6.8
    },
    "hiddenPages": []
  },
  "appearance": {
    "theme": "light"
  }
}
